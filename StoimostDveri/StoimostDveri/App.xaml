<Application x:Class="StoimostDveri.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StoimostDveri"
             StartupUri="MainWindow.xaml">
    <Application.Resources>


        <SolidColorBrush x:Key="PrimaryColor" Color="#4A0E1B"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#6B1A2D"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#2D0810"/>
        <SolidColorBrush x:Key="AccentColor" Color="#C62828"/>
        <SolidColorBrush x:Key="GoldColor" Color="#C9A74C"/>
        <SolidColorBrush x:Key="GoldLightColor" Color="#D4B96A"/>

        <SolidColorBrush x:Key="BackgroundColor" Color="#FDF2F4"/>
        <SolidColorBrush x:Key="CardBackgroundColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HoverBackgroundColor" Color="#FFF5F7"/>

        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2D0810"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#7A4A5A"/>
        <SolidColorBrush x:Key="TextLightColor" Color="#FDF2F4"/>
        <SolidColorBrush x:Key="TextWhiteColor" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BorderColor" Color="#E8C8D0"/>
        <SolidColorBrush x:Key="BorderDarkColor" Color="#C9A7B0"/>

        <SolidColorBrush x:Key="SuccessColor" Color="#2E7D32"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#C62828"/>
        <SolidColorBrush x:Key="WarningColor" Color="#E85D04"/>

        <LinearGradientBrush x:Key="ButtonGradient" EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#4A0E1B" Offset="0"/>
            <GradientStop Color="#6B1A2D" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverGradient" EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#6B1A2D" Offset="0"/>
            <GradientStop Color="#8A2A3D" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonPressGradient" EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#2D0810" Offset="0"/>
            <GradientStop Color="#4A0E1B" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGradient" EndPoint="1,0" StartPoint="0,0">
            <GradientStop Color="#2D0810" Offset="0"/>
            <GradientStop Color="#4A0E1B" Offset="0.5"/>
            <GradientStop Color="#6B1A2D" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PriceGradient" EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#4A0E1B" Offset="0"/>
            <GradientStop Color="#C62828" Offset="1"/>
        </LinearGradientBrush>



        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundColor}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryLightColor}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderDarkColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryLightColor}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BorderDarkColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHoverGradient}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonPressGradient}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#E8D0D5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D4B5BD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C0A0AA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="StatusBarItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="4" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="6" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>