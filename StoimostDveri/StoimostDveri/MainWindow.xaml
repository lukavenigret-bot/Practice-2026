<Window x:Class="StoimostDveri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoimostDveri"
        mc:Ignorable="d"
        Title="Калькулятор стоимости двери - ZaDoor" 
        Height="635" 
        Width="829"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <!-- ========================================== -->
    <!-- ФОНОВОЕ ИЗОБРАЖЕНИЕ                         -->
    <!-- ========================================== -->
    <Window.Background>
        <ImageBrush ImageSource="/Images/background.jpg.jpg" 
                    Stretch="UniformToFill" 
                    Opacity="0.8"/>
    </Window.Background>

    <!-- ========================================== -->
    <!-- ОСНОВНОЙ КОНТЕЙНЕР                        -->
    <!-- ========================================== -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ЗАГОЛОВОК                                  -->
        <!-- ========================================== -->
        <Border Grid.Row="0" 
                CornerRadius="10" 
                Padding="15" 
                Margin="0,0,0,15"
                Background="{StaticResource HeaderGradient}">
            <StackPanel>
                <TextBlock Text="🚪 Калькулятор стоимости двери" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="{StaticResource TextWhiteColor}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="ООО ZaDoor" 
                           FontSize="14" 
                           Foreground="{StaticResource GoldLightColor}"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- ОСНОВНАЯ ЧАСТЬ: ДВЕ КОЛОНКИ               -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="341*"/>
                <!-- Левая колонка (ввод) -->
                <ColumnDefinition Width="448*"/>
                <!-- Правая колонка (результаты) -->
            </Grid.ColumnDefinitions>

            <!-- ========================================== -->
            <!-- ЛЕВАЯ КОЛОНКА: ВВОД ДАННЫХ                -->
            <!-- ========================================== -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">

                <!-- БЛОК 1: Модель двери -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <Border.Background>
                        <ImageBrush ImageSource="/Снимок экрана 2026-06-16 185350.png" Opacity="0.7"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="1. Выбор модели" Style="{StaticResource SectionHeaderStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Модель:" Width="100" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbModel" Width="180" SelectedIndex="0">
                                <ComboBoxItem Content="Стандартная (Classic)" Tag="15000"/>
                                <ComboBoxItem Content="Премиум (Premium)" Tag="25000"/>
                                <ComboBoxItem Content="Эксклюзив (Exclusive)" Tag="40000"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- БЛОК 2: Размеры проёма -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <Border.Background>
                        <ImageBrush ImageSource="/Снимок экрана 2026-06-16 185350.png" Opacity="0.7"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="2. Размеры дверного проёма" Style="{StaticResource SectionHeaderStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Ширина (мм):" Width="100" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtWidth" Width="100" Text="800" TextAlignment="Right"/>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Высота (мм):" Width="100" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtHeight" Width="100" Text="2000" TextAlignment="Right"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- БЛОК 3: Отделка -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <Border.Background>
                        <ImageBrush Stretch="Fill" ImageSource="/Снимок экрана 2026-06-16 185350.png" TileMode="Tile" Opacity="0.7"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="3. Сложность отделки" Style="{StaticResource SectionHeaderStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Коэффициент:" Width="100" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbFinish" Width="180" SelectedIndex="0">
                                <ComboBoxItem Content="Простая (1.0)" Tag="1.0"/>
                                <ComboBoxItem Content="Средняя (1.15)" Tag="1.15"/>
                                <ComboBoxItem Content="Сложная (1.3)" Tag="1.3"/>
                                <ComboBoxItem Content="Эксклюзивная (1.5)" Tag="1.5"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- КНОПКИ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="btnCalculate" Content="Рассчитать стоимость" Width="180"/>
                    <Button x:Name="btnClear" Content="Очистить" Width="100" Style="{StaticResource ClearButtonStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- ПРАВАЯ КОЛОНКА: РЕЗУЛЬТАТЫ                -->
            <!-- ========================================== -->
            <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ResultCardStyle}" 
                    Margin="15,0,0,0" Height="270">
                <Border.Background>
                    <ImageBrush ImageSource="/Снимок экрана 2026-06-16 185350.png" Opacity="0.7"/>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="📋 РЕЗУЛЬТАТЫ РАСЧЁТА" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryColor}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Модель -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Модель:" FontWeight="Bold" Margin="0,5,10,5" 
                                   Foreground="{StaticResource TextPrimaryColor}" FontSize="14"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblModel" Text="—" 
                                   Style="{StaticResource ResultLabelStyle}" FontSize="14"
                                   TextWrapping="Wrap"/>

                        <!-- Площадь -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Площадь:" FontWeight="Bold" Margin="0,5,10,5" 
                                   Foreground="{StaticResource TextPrimaryColor}" FontSize="14"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblArea" Text="—" 
                                   Style="{StaticResource ResultLabelStyle}" FontSize="14"/>

                        <!-- Надбавка -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Надбавка:" FontWeight="Bold" Margin="0,5,10,5" 
                                   Foreground="{StaticResource TextPrimaryColor}" FontSize="14"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblSizeSurcharge" Text="—" 
                                   Style="{StaticResource ResultLabelStyle}" FontSize="14"/>

                        <!-- Коэффициент -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Отделка:" FontWeight="Bold" Margin="0,5,10,5" 
                                   Foreground="{StaticResource TextPrimaryColor}" FontSize="14"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblFinishCoeff" Text="—" 
                                   Style="{StaticResource ResultLabelStyle}" FontSize="14"/>

                        <!-- Разделитель -->
                        <Separator Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10" Background="{StaticResource GoldColor}" Opacity="0.5"/>

                        <!-- ИТОГО -->
                        <Border Grid.Row="5" Grid.ColumnSpan="2" 
                                CornerRadius="8" 
                                Padding="12" 
                                Margin="0,5,0,0"
                                Background="{StaticResource PriceGradient}"
                                VerticalAlignment="Bottom">
                            <TextBlock x:Name="lblFinalPrice" 
                                       Text="ИТОГО: 0 ₽" 
                                       FontSize="22" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextWhiteColor}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- СТАТУС-БАР                                -->
        <!-- ========================================== -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" 
                           Text="Готов к расчёту" 
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryColor}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>