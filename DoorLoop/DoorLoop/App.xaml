<Application x:Class="DoorLoop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DoorLoop"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="PrimaryColor" Color="#4A0E1B"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#6B1A2D"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#2D0810"/>
        <SolidColorBrush x:Key="AccentColor" Color="#C62828"/>
        <SolidColorBrush x:Key="GoldColor" Color="#C9A74C"/>
        <SolidColorBrush x:Key="GoldLightColor" Color="#D4B96A"/>

        <SolidColorBrush x:Key="CardBackgroundColor" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="ResultCardBackground" Color="#E6FDF2F4"/>
        <SolidColorBrush x:Key="ListBackgroundColor" Color="#CCFFFFFF"/>

        <LinearGradientBrush x:Key="HeaderGradient" EndPoint="1,0" StartPoint="0,0">
            <GradientStop Color="#E62D0810" Offset="0"/>
            <GradientStop Color="#E64A0E1B" Offset="0.5"/>
            <GradientStop Color="#E66B1A2D" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PriceGradient" EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#E64A0E1B" Offset="0"/>
            <GradientStop Color="#E6C62828" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#E64A0E1B" Offset="0"/>
            <GradientStop Color="#E66B1A2D" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverGradient" EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#E66B1A2D" Offset="0"/>
            <GradientStop Color="#E68A2A3D" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2D0810"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#7A4A5A"/>
        <SolidColorBrush x:Key="TextWhiteColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#80E8C8D0"/>
        <SolidColorBrush x:Key="GoldBorderColor" Color="#80C9A74C"/>

        <SolidColorBrush x:Key="SuccessColor" Color="#2E7D32"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#C62828"/>


        <Style TargetType="Window">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryLightColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryLightColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhiteColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHoverGradient}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#D9E8D0D5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CCD4B5BD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Background" Value="#D32F2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B71C1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ResultCardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource GoldBorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" BlurRadius="8" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource ListBackgroundColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="MinHeight" Value="100"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6C9A74C"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6F5E6D3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>