<Window x:Class="DoorDebug.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 Отладка калькулятора дверей" 
        Height="650" 
        Width="650"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" 
                   Text="🔍 Отладка калькулятора дверей" 
                   FontSize="22" 
                   FontWeight="Bold"
                   Foreground="#4A0E1B"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="Модель:" 
                   FontSize="14" 
                   VerticalAlignment="Center"
                   Margin="0,5,10,5"/>

        <ComboBox Grid.Row="1" Grid.Column="1" 
                  x:Name="cmbModel" 
                  Width="200" 
                  Height="30"
                  SelectedIndex="-1"
                  Margin="0,5,10,5"
                  VerticalAlignment="Center">
            <ComboBoxItem Content="Стандартная (Classic)" Tag="15000"/>
            <ComboBoxItem Content="Премиум (Premium)" Tag="25000"/>
            <ComboBoxItem Content="Эксклюзив (Exclusive)" Tag="40000"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="2" 
                   x:Name="lblModelWarning" 
                   Text="" 
                   FontSize="11" 
                   Foreground="Red"
                   VerticalAlignment="Center"
                   Margin="5,5,0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="Ширина (мм):" 
                   FontSize="14" 
                   VerticalAlignment="Center"
                   Margin="0,5,10,5"/>

        <TextBox Grid.Row="2" Grid.Column="1" 
                 x:Name="txtWidth" 
                 Width="150" 
                 Height="30"
                 Text="800"
                 Margin="0,5,10,5"
                 VerticalAlignment="Center"
                 TextAlignment="Right"/>

        <TextBlock Grid.Row="2" Grid.Column="2" 
                   x:Name="lblWidthWarning" 
                   Text="" 
                   FontSize="11" 
                   Foreground="Red"
                   VerticalAlignment="Center"
                   Margin="5,5,0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="Высота (мм):" 
                   FontSize="14" 
                   VerticalAlignment="Center"
                   Margin="0,5,10,5"/>

        <TextBox Grid.Row="3" Grid.Column="1" 
                 x:Name="txtHeight" 
                 Width="150" 
                 Height="30"
                 Text="2000"
                 Margin="0,5,10,5"
                 VerticalAlignment="Center"
                 TextAlignment="Right"/>

        <TextBlock Grid.Row="3" Grid.Column="2" 
                   x:Name="lblHeightWarning" 
                   Text="" 
                   FontSize="11" 
                   Foreground="Red"
                   VerticalAlignment="Center"
                   Margin="5,5,0,5"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20">

            <Button x:Name="btnCalculate" 
                    Content="▶ Рассчитать" 
                    Width="220" 
                    Height="45"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#4A0E1B" 
                    Foreground="White"
                    Margin="0,0,10,0"
                    Click="BtnCalculate_Click"/>

            <Button x:Name="btnDebug" 
                    Content="🔍 Инструкция по отладке" 
                    Width="180" 
                    Height="45"
                    FontSize="13"
                    Background="#C62828" 
                    Foreground="White"
                    Click="BtnDebug_Click"/>
        </StackPanel>

        <Border Grid.Row="5" Grid.ColumnSpan="3" 
                Background="#F5F5F5" 
                CornerRadius="8" 
                Padding="15"
                Margin="0,10,0,0"
                BorderBrush="#CCCCCC"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="📋 РЕЗУЛЬТАТ РАСЧЁТА" 
                           FontWeight="Bold"
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" 
                           x:Name="lblResult" 
                           Text="Нажмите «Рассчитать»" 
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Row="2" 
                           x:Name="lblDebugInfo" 
                           Text=""
                           FontSize="12"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="500"/>
            </Grid>
        </Border>

        <Border Grid.Row="6" Grid.ColumnSpan="3" 
                Background="#FFF8E1" 
                CornerRadius="8" 
                Padding="15"
                Margin="0,10,0,0"
                BorderBrush="#FFB300"
                BorderThickness="1">

            <StackPanel>
                <TextBlock Text="💡 ИНСТРУКЦИЯ ПО ОТЛАДКЕ" 
                           FontWeight="Bold"
                           Foreground="#E65100"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock x:Name="lblInstructions" 
                           Text="Нажмите «Инструкция по отладке» для подробной информации"
                           FontSize="12"
                           Foreground="#333333"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>