<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DoorMobileApp.MainPage"
             Title="Калькулятор дверей">

    <!-- ========================================================= -->
    <!-- ОСНОВНОЙ КОНТЕЙНЕР (ScrollView для прокрутки)              -->
    <!-- ========================================================= -->
    <ScrollView Padding="20">

        <VerticalStackLayout Spacing="15">

            <!-- ========================================================= -->
            <!-- 1. ЗАГОЛОВОК                                               -->
            <!-- ========================================================= -->
            <Label Text="🚪 Калькулятор стоимости двери"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#4A0E1B"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Label Text="ООО ZaDoor"
                   FontSize="14"
                   TextColor="#7A4A5A"
                   HorizontalOptions="Center"
                   Margin="0,-10,0,10"/>

            <!-- ========================================================= -->
            <!-- 2. МОДЕЛЬ                                                 -->
            <!-- ========================================================= -->
            <Label Text="Модель:"
                   FontSize="14"
                   FontAttributes="Bold"/>

            <Picker x:Name="cmbModel"
                    Title="Выберите модель"
                    SelectedIndex="0">
                <Picker.Items>
                    <x:String>Стандартная (Classic) - 15 000 ₽</x:String>
                    <x:String>Премиум (Premium) - 25 000 ₽</x:String>
                    <x:String>Эксклюзив (Exclusive) - 40 000 ₽</x:String>
                </Picker.Items>
            </Picker>

            <!-- ========================================================= -->
            <!-- 3. ШИРИНА                                                 -->
            <!-- ========================================================= -->
            <Label Text="Ширина (мм):"
                   FontSize="14"
                   FontAttributes="Bold"/>

            <Entry x:Name="txtWidth"
                   Text="800"
                   Keyboard="Numeric"
                   Placeholder="Введите ширину"/>

            <Label Text="(стандарт: 800-900)"
                   FontSize="12"
                   TextColor="Gray"
                   Margin="0,-5,0,0"/>

            <!-- ========================================================= -->
            <!-- 4. ВЫСОТА                                                 -->
            <!-- ========================================================= -->
            <Label Text="Высота (мм):"
                   FontSize="14"
                   FontAttributes="Bold"/>

            <Entry x:Name="txtHeight"
                   Text="2000"
                   Keyboard="Numeric"
                   Placeholder="Введите высоту"/>

            <Label Text="(стандарт: 2000-2100)"
                   FontSize="12"
                   TextColor="Gray"
                   Margin="0,-5,0,0"/>

            <!-- ========================================================= -->
            <!-- 5. ОТДЕЛКА                                                -->
            <!-- ========================================================= -->
            <Label Text="Отделка:"
                   FontSize="14"
                   FontAttributes="Bold"/>

            <Picker x:Name="cmbFinish"
                    Title="Выберите отделку"
                    SelectedIndex="0">
                <Picker.Items>
                    <x:String>Простая (1.0)</x:String>
                    <x:String>Средняя (1.15)</x:String>
                    <x:String>Сложная (1.3)</x:String>
                    <x:String>Эксклюзивная (1.5)</x:String>
                </Picker.Items>
            </Picker>

            <!-- ========================================================= -->
            <!-- 6. КНОПКИ                                                 -->
            <!-- ========================================================= -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10">

                <Button x:Name="btnCalculate"
                        Text="Рассчитать"
                        BackgroundColor="#4A0E1B"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Grid.Column="0"/>

                <Button x:Name="btnClear"
                        Text="Очистить"
                        BackgroundColor="#757575"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Grid.Column="1"/>

            </Grid>

            <!-- ========================================================= -->
            <!-- 7. РЕЗУЛЬТАТЫ                                             -->
            <!-- ========================================================= -->
            <Frame BackgroundColor="#F5F5F5"
                   CornerRadius="10"
                   Padding="15"
                   Margin="0,10,0,0">

                <VerticalStackLayout>

                    <Label Text="📋 РЕЗУЛЬТАТЫ РАСЧЁТА"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10"/>

                    <Label x:Name="lblResult"
                           Text="Нажмите «Рассчитать»"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#4A0E1B"
                           HorizontalOptions="Center"/>

                    <Label x:Name="lblDetails"
                           Text="Введите данные и нажмите «Рассчитать»"
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"
                           LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

            </Frame>

            <!-- ========================================================= -->
            <!-- 8. СТАТУС                                                 -->
            <!-- ========================================================= -->
            <Label x:Name="lblStatus"
                   Text="Готов к расчёту"
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>